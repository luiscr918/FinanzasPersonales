rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This UID is the only account allowed to access this private workspace.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == 'yutbg6NTU8Q5VFRt0OM2bYeqdJt1' && uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
